# Supabase Environment Configuration
# Replace these with your Supabase project credentials from Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service role key (Never expose to client/browser, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Allowed Administrator Email Addresses (comma-separated)
